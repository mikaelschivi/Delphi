# Copy to .env and fill in before running docker compose or scripts/deploy.sh.

# Application
POSTGRES_USER=delphi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=delphi
POLL_INTERVAL_S=60

# Deploy target for scripts/deploy.sh.
# DEPLOY_HOST is required; everything below has a default.
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=root
DEPLOY_PATH=app
DEPLOY_SSH_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
